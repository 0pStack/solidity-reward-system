{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": ["error", "0.8.31"],
    "func-visibility": [
      "error",
      {
        "ignoreConstructors": true
      }
    ],
    "no-empty-blocks": "off",
    "gas-custom-errors": "error",
    "use-natspec": "off",
    "gas-indexed-events": "off",
    "import-path-check": "off"
  }
}
